# Dai backend environment.
# Copy to .env and adjust. Never commit .env or real credentials.

# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# APP_ENV defaults to development. A fresh clone runs with zero configuration
# (SQLite file, dev secrets). To use local Postgres instead:
#   docker compose up -d          (from the repo root)
#   DATABASE_URL=postgresql+psycopg2://dai:dai@localhost:5432/dai
# DATABASE_URL=sqlite:///dai.db

# ── PRODUCTION (APP_ENV=production) ──────────────────────────────────────────
# All variables below are REQUIRED. The app refuses to start if SECRET_KEY or
# JWT_SECRET_KEY are missing or still the development defaults (fail-closed).
APP_ENV=production

# PostgreSQL connection string (Render/Supabase/Neon/…).
# postgres:// is accepted and normalized to postgresql:// automatically.
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DBNAME

# Long random strings. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-me-with-a-long-random-string
JWT_SECRET_KEY=replace-me-with-a-long-random-string

# Token lifetime in seconds (default 30 days — pragmatic for a daily-use phone app)
JWT_ACCESS_TOKEN_EXPIRES=2592000

# CORS origins (comma-separated). The deployed frontend origin(s) only —
# never "*". Dev default allows the Vite dev server.
CORS_ORIGINS=https://YOUR-FRONTEND-DOMAIN.example